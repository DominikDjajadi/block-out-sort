  "tests": [
    {
      "name": "single red mono: stops + matching exit",
      "setup": {
        "blocks": [
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ]
          }
        ]
      },
      "expect": {
        "canonicalKey": "red#0#2,1",
        "cleared": 0,
        "terminal": false,
        "legalActions": [
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "down",
            "distance": 1,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "down",
            "distance": 2,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "left",
            "distance": 1,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "right",
            "distance": 1,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "right",
            "distance": 2,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "right",
            "distance": 3,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "up",
            "distance": 1,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "up",
            "distance": 2,
            "exit": false
          },
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ],
            "dir": "up",
            "distance": 2,
            "exit": true
          }
        ]
      },
      "apply": [
        {
          "color": "red",
          "cells": [
            [
              2,
              1
            ]
          ],
          "dir": "up",
          "distance": 2,
          "exit": true
        }
      ],
      "expectError": false,
      "after": {
        "canonicalKey": "",
        "cleared": 1,
        "terminal": true
      }
    },
    {
      "name": "slide stops at another block",
      "setup": {
        "blocks": [
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ]
          },
          {
            "color": "blue",
            "cells": [
              [
                2,
                3
              ]
            ]
          }
        ]
      },
      "expect": {
        "canonicalKey": "blue#0#2,3|red#0#2,1",
        "cleared": 0,
        "terminal": false
      },
      "apply": [
        {
          "color": "red",
          "cells": [
            [
              2,
              1
            ]
          ],
          "dir": "right",
          "distance": 1,
          "exit": false
        }
      ],
      "expectError": false,
      "after": {
        "canonicalKey": "blue#0#2,3|red#0#2,2",
        "cleared": 0,
        "terminal": false
      }
    },
    {
      "name": "illegal: slide past blocking block",
      "setup": {
        "blocks": [
          {
            "color": "red",
            "cells": [
              [
                2,
                1
              ]
            ]
          },
          {
            "color": "blue",
            "cells": [
              [
                2,
                3
              ]
            ]
          }
        ]
      },
      "expect": {
        "canonicalKey": "blue#0#2,3|red#0#2,1",
        "cleared": 0,
        "terminal": false
